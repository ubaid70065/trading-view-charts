# Angel One SmartAPI credentials.
#
# Copy this file to .env and fill it in. .env is gitignored and is never served
# by the dev server (see PRIVATE_PATHS in server.js).
#
# The API key on its own cannot log in — SmartAPI needs all four values.

# From https://smartapi.angelbroking.com/ → My Apps → your app's API key.
SMARTAPI_KEY=

# Your Angel One client / login ID (e.g. A123456).
SMARTAPI_CLIENT_CODE=

# Your login PIN (the numeric MPIN, not the app password).
SMARTAPI_PASSWORD=

# Base32 TOTP secret shown when you enable TOTP at
# https://smartapi.angelbroking.com/enable-totp — the string behind the QR code,
# not the six digits it displays. The server generates codes from it.
SMARTAPI_TOTP_SECRET=

# Optional. SmartAPI requires these headers but does not validate them.
# SMARTAPI_LOCAL_IP=127.0.0.1
# SMARTAPI_PUBLIC_IP=127.0.0.1
# SMARTAPI_MAC=00:00:00:00:00:00

# Optional override, e.g. to the legacy host apiconnect.angelbroking.com
# SMARTAPI_BASE_URL=https://apiconnect.angelone.in
