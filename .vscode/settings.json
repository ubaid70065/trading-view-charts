{
    // This project's own server owns port 5500 (see server.js), because it is
    // the only one that can serve the /api routes the NSE panes need. Live
    // Server is moved aside so the two stop fighting over the port — otherwise
    // whichever starts first wins, and if Live Server wins the page still loads
    // but every /api call 404s and no NSE data appears.
    //
    // Run the app with: npm start   →   http://localhost:5500
    "liveServer.settings.port": 5501
}
